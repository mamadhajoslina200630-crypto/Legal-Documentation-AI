# Environment Configuration
PROJECT_NAME="Legal AI Simplifier"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (Defaults to zero-config local SQLite; can also use PostgreSQL)
DATABASE_URL=sqlite:///./legal_ai.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_ai_db

# Object Storage
STORAGE_DIR=./storage_data

# AI Provider Configuration
# Set your Gemini API key below to enable live Gemini AI models (defaults to intelligent local legal engine if omitted)
ACTIVE_AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Cache & Vector DB (Optional - defaults to in-memory/embedded local fallback if omitted or offline)
# REDIS_URL=redis://localhost:6379/0
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# JWT Authentication
SECRET_KEY=dev_secret_key_legal_ai_simplifier_local_development_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
